<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 12+.
   The session DataStore holds the auth token and must never be backed up
   to the cloud or copied to another device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
